<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local network only: no internet permission is used to reach any server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Keep the bridge alive with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!--
      Android 14+ requires a *type-specific* permission for every kind of work a
      foreground service does, in addition to FOREGROUND_SERVICE:

        camera         streaming the phone's camera while the screen is off
        microphone     streaming the phone's microphone while the screen is off
        mediaPlayback  playing the PC's audio through AudioTrack

      All three are "normal" permissions: granted at install, never prompted, and
      they grant nothing on their own - CAMERA and RECORD_AUDIO stay the runtime
      permissions the user actually decides on, and the service only claims a type
      while the matching runtime permission is held (see BridgeService).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Required by the platform for a `connectedDevice` foreground service on
      Android 14+. startForeground() throws SecurityException unless the app
      holds FOREGROUND_SERVICE_CONNECTED_DEVICE *and* at least one of a fixed
      list (BLUETOOTH_*, CHANGE_NETWORK_STATE, CHANGE_WIFI_STATE, NFC, ...).
      CHANGE_NETWORK_STATE is the honest member of that list for this app: the
      service exists to maintain a network connection to the phone-as-server.
      Both are "normal" permissions - granted at install, no runtime prompt, and
      they grant no capability this app actually exercises.
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!--
      Capability measurement (Phase 2 preparation). These are used by the
      read-only CapabilityProbe and by nothing else yet - the audio relay itself
      is not implemented. Each one is requested at the moment it is needed:

        MODIFY_AUDIO_SETTINGS  normal; routing audio to a SCO device
        RECORD_AUDIO           runtime; the microphone test (only when run)
        BLUETOOTH_CONNECT      runtime (API 31+); adapter and headset state
        BLUETOOTH              normal, API <= 30 only; profile queries there
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
        Phase 4. Declared because the app now streams camera frames to a paired
        PC on request; requested the first time the user starts the camera in the
        app, never at launch. `required=false` keeps the APK installable on a
        device without a camera, which then reports camera.stream unavailable
        instead of crashing.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!--
        Phase 5. Scanning for Bluetooth LE peripherals is a runtime permission on
        Android 12+ and was folded into location before that. Only scanning needs
        BLUETOOTH_SCAN; opening a GATT link needs BLUETOOTH_CONNECT (above), which
        Phase 1 already declared for headset facts. `neverForLocation` is honest:
        the app does not use scan results to derive a location.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!--
      Sensors: Android 12+ gates sampling faster than 200 Hz (and some vendors gate
      more) behind HIGH_SAMPLING_RATE_SENSORS. It is a *normal* permission, granted
      at install with no prompt, so declaring it costs the user nothing and lets
      `sensor.list` report a measured "permitted" instead of a constant. Without the
      declaration `checkSelfPermission` always answers "denied" and streaming would
      be refused for a reason that was never true.
    -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!--
      enableOnBackInvokedCallback opts in to predictive back. Android 16 makes it
      the default for apps targeting SDK 36, so opting in now means back
      behaviour does not change under us at the next targetSdk bump. The app has
      no custom back handling, so the system gesture simply closes the activity.
    -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_phonebridge"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneBridge"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic is required because the control channel is a
          plain WebSocket that PhoneBridge encrypts itself (P-256 ECDH +
          AES-256-GCM). Running TLS on top would add a second, unpinned layer
          with certificates we would have to manage on both ends.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          connectedDevice is the primary type: the service exists to hold a
          connection to the PC. camera, microphone and mediaPlayback describe the
          work it does *through* that connection, and each is only claimed while
          the phone has the matching runtime permission.
        -->
        <service
            android:name=".service.BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|camera|microphone|mediaPlayback" />
    </application>
</manifest>
